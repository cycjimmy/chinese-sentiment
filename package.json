{
  "name": "@cycjimmy/chinese-sentiment",
  "type": "module",
  "version": "3.0.0",
  "description": "Chinese sentiment analysis for Node",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/chinese-sentiment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/chinese-sentiment.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/chinese-sentiment/issues"
  },
  "keywords": [
    "chinese",
    "sentiment"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "prepare": "npm run dict:handle",
    "dict:handle": "node tasks/dictionaryHanding.ts && node tasks/bosonNlpDataHanding.ts",
    "type-check": "tsc --noEmit",
    "type-check:dist": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck false dist/index.d.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node tasks/removeDir.ts dist && npm run build:esm && npm run build:types && npm run build:assets",
    "build:esm": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:assets": "node tasks/copyDictionaries.ts",
    "package": "node tasks/removeDir.ts .release && npm run dict:handle && npm run build && node tasks/copyFiles.ts && node tasks/handlePackageJson.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "nodejieba": "^3.5.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cycjimmy/config-lib": "^3.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "fs-extra": "^11.2.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
